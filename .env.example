# Copy to .env for local dev (`vercel dev`), and set the same values in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Public URL of the site (where the QR code points)
SITE_URL=https://your-site.vercel.app/

# Random secrets. Generate each with:  openssl rand -base64 32
TOKEN_SECRET=
QR_ACCESS_KEY=

# How long a QR code stays valid, in minutes
TOKEN_TTL_MINUTES=120

# Cloudflare Turnstile secret key (the site key goes in public/config.js)
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com): API key + a sender on a domain you have verified there
RESEND_API_KEY=
MAIL_FROM="Alexandra <cv@your-domain.com>"
MAIL_REPLY_TO=you@example.com
# Optional: get a notification each time someone requests your CV
NOTIFY_EMAIL=you@example.com

# A private, unguessable URL that returns your CV PDF (NOT inside this public repo)
CV_URL=
CV_FILENAME=Alexandra_CV.pdf
OWNER_NAME=Alexandra
